# =====================================================
# PlotFinder Backend — пример переменных окружения
# =====================================================
#
# КАК ИСПОЛЬЗОВАТЬ:
#   1. Скопируйте этот файл в `.env`:
#      cp .env.example .env
#   2. Заполните реальными значениями ключей.
#   3. Никогда не коммитьте `.env` в git — он заблокирован в .gitignore.
#
# ВНИМАНИЕ:
#   Файл `.env` должен находиться в одной директории с main.py
#   (или в директории, из которой запускается uvicorn).
#

# -----------------------------------------------------
# ОБЯЗАТЕЛЬНЫЕ переменные
# Без них сервер не запустится — выдаст ошибку при старте.
# -----------------------------------------------------

# NextGIS Toolbox API
# Используется для получения геометрии участка по кадастровому номеру.
# Где взять: https://toolbox.nextgis.com/ → личный кабинет → API tokens
# Тариф: от 6 000 ₽/мес за пакет запросов к cadnums_to_geodata
# Формат: UUID v4, например: 12345678-1234-1234-1234-123456789abc
TOOLBOX_API_KEY=your-toolbox-api-key-here

# OpenRouter API
# Используется для LLM-анализа юридических рисков (модель Qwen3-32B).
# Где взять: https://openrouter.ai/keys → Create Key
# Стоимость: ~0,04 ₽ за один запрос к Qwen3-32B (на ноябрь 2026)
# Формат: sk-or-v1-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here


# -----------------------------------------------------
# ОПЦИОНАЛЬНЫЕ переменные
# Имеют значения по умолчанию.
# -----------------------------------------------------

# Директория для кэша GeoJSON-файлов от NextGIS Toolbox.
# При первом запросе геометрия кэшируется локально, чтобы не делать
# повторных платных запросов к Toolbox для одного и того же кадастра.
# По умолчанию: ./output/geojson (относительный путь от main.py)
# На production-сервере удобнее абсолютный путь, например:
#   GEOJSON_DIR=/var/lib/plotfinder/geojson
# GEOJSON_DIR=./output/geojson
